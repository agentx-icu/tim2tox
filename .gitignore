# Local agent / tooling state
.claude/
.cache/

# Generated by the INTEGRATOR's bootstrap (toxee tool/bootstrap_deps.dart), never
# committed: it points dart/ at the patched tencent_cloud_chat_sdk and the forked
# uikit under the integrator's third_party/. Tim2Tox does not depend on toxee, so
# this stays a local artifact — without it, analysing dart/ on its own resolves
# both from pub.dev and reports ~21 errors that no real build has.
pubspec_overrides.yaml

# ...and the lock it makes pub rewrite. `flutter pub get` with those overrides in
# place pulls the FORK's transitive deps (chewie_for_us, cupertino_icons, ...) into
# dart/pubspec.lock, which is the integrator's resolution, not this library's. A
# plain pub get here does NOT touch the lock, so the churn comes from the
# overrides alone; ignoring it keeps a tracked file from sitting permanently dirty
# and being committed by accident.
dart/pubspec.lock
